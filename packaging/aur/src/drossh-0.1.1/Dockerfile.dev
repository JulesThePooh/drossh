# ─────────────────────────────────────────────────────────────
#  Boîte à outils de DÉVELOPPEMENT (reste 100 % dans Docker).
#  Contient : Go + Node + Wails + le moteur d'affichage webkit/gtk.
#  Rien de tout ça n'est installé sur ta machine.
#
#  Base Arch Linux : mêmes versions de libs que ta CachyOS,
#  pour que l'appli compilée ici tourne sans souci sur ta machine.
# ─────────────────────────────────────────────────────────────
FROM archlinux:latest

# Outils de compil + Go + Node + webkit/gtk (pour compiler l'interface)
RUN pacman -Syu --noconfirm --needed \
      base-devel git go nodejs npm \
      webkit2gtk-4.1 gtk3 pkgconf \
 && pacman -Scc --noconfirm

# Le CLI Wails (génère et compile l'appli)
ENV GOPATH=/go
ENV PATH="/go/bin:${PATH}"
RUN go install github.com/wailsapp/wails/v2/cmd/wails@latest

WORKDIR /app
